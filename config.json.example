{
  "_about": "Single source of truth for pi-image. Copy to config.json (gitignored) and adjust. pi-image needs no cloud creds — image generation runs through the Codex/ChatGPT subscription via the local `codex` CLI (no OPENAI_API_KEY).",

  "stateDir": "~/.pi-image",
  "_stateDir_note": "Where pi-image writes its logs (<stateDir>/logs/image.log). The RPC driver also keeps session state here.",

  "model": "openai-codex/gpt-5.6-terra",
  "_model_note": "The pi spoke (orchestrator) model. openai-codex/* runs on the Codex/ChatGPT subscription. Empty = pi default.",
  "thinking": "high",
  "_thinking_note": "Reasoning tier for the spoke. Empty = pi default.",

  "codex": {
    "_note": "How the gpt-image-2 backend drives the Codex CLI's built-in image_gen (subscription-billed). All optional; these are the defaults.",
    "bin": "codex",
    "model": "gpt-5.6-sol",
    "home": "~/.codex",
    "sandbox": "workspace-write",
    "network": true,
    "timeoutMs": 900000,
    "_timeoutMs_note": "Backstop against a hung codex, NOT an operating limit — set it well above the slowest legitimate run. Generates land at 1-2 min, but an edit was killed mid-render at the old 300000 ceiling."
  }
}
